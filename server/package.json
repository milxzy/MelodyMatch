{
    "name": "melodymatch-server",
    "version": "1.0.0",
    "description": "MelodyMatch backend — music-based dating app API",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "npm i && nodemon server.js",
        "build": "echo 'No build step for backend'",
        "test": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --coverage",
        "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/.bin/jest --watch",
        "seed": "node scripts/seedUsers.js",
        "seed:clear": "node scripts/seedUsers.js --clear",
        "seed:diverse": "node scripts/seedUsers.js --strategy diverse --count 30",
        "seed:clustered": "node scripts/seedUsers.js --strategy clustered --count 40",
        "seed:realistic": "node scripts/seedUsers.js --strategy realistic --count 50",
        "seed:interactions": "node scripts/seedInteractions.js",
        "seed:likes": "node scripts/seedInteractions.js --likes 100",
        "seed:matches": "node scripts/seedInteractions.js --matches 30",
        "clear:bots": "node scripts/seedUsers.js --count 0 --clear"
    },
    "type": "module",
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "body-parser": "^1.20.2",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-async-handler": "^1.2.0",
        "express-rate-limit": "^7.1.5",
        "express-session": "^1.18.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.3",
        "mongodb": "^6.11.0",
        "mongodb-connection-string-url": "^3.0.1",
        "mongoose": "^8.8.2",
        "node-fetch": "^3.3.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "passport-local-mongoose": "^8.0.0",
        "socket.io": "^4.7.2",
        "tr46": "^5.0.0",
        "whatwg-url": "^14.0.0",
        "winston": "^3.11.0",
        "winston-daily-rotate-file": "^4.7.1"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.8",
        "jest": "^29.7.0",
        "nodemon": "^3.1.7",
        "supertest": "^6.3.3"
    },
    "jest": {
        "testEnvironment": "node",
        "transform": {},
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "testMatch": [
            "**/tests/**/*.test.js"
        ]
    }
}
